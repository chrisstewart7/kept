# ── PayPig production environment ──────────────────────────────────────
# Launches stay DISABLED (red banner) until treasury + RPC are real.

# Paid RPC (Helius / Triton / QuickNode). Public mainnet-beta will drop you.
NEXT_PUBLIC_SOLANA_RPC=

# Real fee-share recipient pubkey. The placeholder keeps launches disabled.
NEXT_PUBLIC_TREASURY=

# $PAYPIG mint once launched. Until set, /paypig says "not launched yet".
NEXT_PUBLIC_PAYPIG_MINT=

NEXT_PUBLIC_X_HANDLE=@PayPigApp

# Optional program-id overrides (SDK defaults are current mainnet ids)
NEXT_PUBLIC_PUMP_PROGRAM=
NEXT_PUBLIC_PUMP_FEES_PROGRAM=

# OnlyFans public-profile lookup, Path 2 fallback (onlyfansapi.com)
ONLYFANSAPI_KEY=

# Indexer auth for future cron endpoints
PAYPIG_INDEXER_SECRET=
